<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.starfox.port">

    <!-- Sin uses-sdk, aapt2 asume minSdk 1 y anade permisos
         implicitos (WRITE_EXTERNAL_STORAGE, READ_PHONE_STATE)
         que este port NO pide: fijar los de build.gradle. -->
    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" />

    <!-- android:debuggable="true" SOLO para APKs de prueba
         (Fase 0 arranque, Fase 10 GX): permite leer boot.log
         con run-as. Las APKs de prueba se etiquetan como tales
         en su nombre y en PORT-STATUS. Quitar para cualquier
         build de release. -->
    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.lib_name"
                android:value="starfox" />
        </activity>

    </application>

</manifest>
